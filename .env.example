# ==============================================
# FACILADMIN - Variables de Entorno
# ==============================================
# Copia este archivo como .env y configura los valores

# ==============================================
# ENTORNO
# ==============================================
# local = desarrollo local (SQLite, sin Redis)
# production = producción (PostgreSQL, Redis opcional)
DJANGO_ENVIRONMENT=local

# ==============================================
# SEGURIDAD
# ==============================================
# IMPORTANTE: Genera una SECRET_KEY única para producción
# Puedes usar: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-in-production

# Debug mode (NUNCA usar True en producción)
DEBUG=True

# Hosts permitidos (separados por coma)
# Desarrollo: localhost,127.0.0.1
# Producción: .railway.app,tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================
# BASE DE DATOS - DESARROLLO LOCAL
# ==============================================
# Para usar SQLite (por defecto en local):
DB_ENGINE=sqlite

# Para usar PostgreSQL local (opcional):
# DB_ENGINE=postgresql
# DB_NAME=faciladmin_db
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_HOST=localhost
# DB_PORT=5432

# ==============================================
# BASE DE DATOS - PRODUCCIÓN (Railway)
# ==============================================
# Railway proporciona DATABASE_URL automáticamente
# No necesitas configurar esto manualmente
# DATABASE_URL=postgresql://user:password@host:port/database

# ==============================================
# REDIS (Opcional - Solo para producción con Celery)
# ==============================================
# Railway proporciona REDIS_URL automáticamente si agregas Redis
# REDIS_URL=redis://localhost:6379/0

# Modo Celery (True = sin Redis, False = con Redis)
USE_CELERY_EAGER=True

# ==============================================
# EMAIL
# ==============================================
# Desarrollo: django.core.mail.backends.console.EmailBackend
# Producción: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password

# ==============================================
# CLOUDINARY (Almacenamiento de imágenes)
# ==============================================
# Registro gratis en: https://cloudinary.com/users/register_free
# Después de registrarte, copia los valores del Dashboard
CLOUDINARY_CLOUD_NAME=dyjz4o32i
CLOUDINARY_API_KEY=398541256631776
CLOUDINARY_API_SECRET=5WuCHn_8Ff1kyhKJj5UPbPOFEFo

# ==============================================
# TWILIO (WhatsApp y SMS)
# ==============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ==============================================
# CORS (Frontend permitidos)
# ==============================================
# Separados por coma, sin espacios
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================
# SITE URL
# ==============================================
# Desarrollo: http://localhost:8000
# Producción: https://tu-app.up.railway.app
SITE_URL=http://localhost:8000

# ==============================================
# SEGURIDAD ADICIONAL (Solo producción)
# ==============================================
# SECURE_SSL_REDIRECT=True
# ADMIN_URL=admin-secreto/

# ==============================================
# RAILWAY (Automático - No configurar manualmente)
# ==============================================
# Railway configura estas variables automáticamente:
# - DATABASE_URL
# - REDIS_URL (si agregas Redis)
# - RAILWAY_STATIC_URL
# - PORT
